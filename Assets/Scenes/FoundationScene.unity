    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u76EE\u6807\uFF1A\u593A\u53D6 (6,4) \u7684\u5BC6\u62A5\uFF0C\u518D\u4ECE (0,0)\u3001(1,0) \u64A4\u79BB\u3002\n\u6267\u884C\u65B9\u5F0F\uFF1A\u4EB2\u81EA\u6267\u884C\uFF5C\u51C6\u5907\uFF1A\u4E0D\u51C6\u5907\n\u7ED3\u7B97\uFF1A\u7ED3\u675F\u6263\u9664 2 \u7269\u8D44\uFF08\u4FA6\u5BDF\u51C6\u5907\u518D +1\uFF0C\u5171 2\uFF09\u3002\n\u5B8C\u5168\u6210\u529F\uFF1A+4 \u8D44\u91D1\u3001+6 \u60C5\u62A5\u3001\u540D\u671B +3\u3001\u5173\u7CFB +5\u3001\u9690\u853D\u5EA6 +3\u3002\n\u6210\u529F\u4F46\u6709\u4EE3\u4EF7\uFF1A\u518D\u4ED8 1 \u7269\u8D44\uFF08\u540D\u671B +2\uFF0F\u5173\u7CFB +2\uFF0F\u9690\u853D\u5EA6 +1\uFF09\u3002\n\u5931\u8D25\u5E76\u5B89\u5168\u64A4\u79BB\uFF1A\u540D\u671B -1\uFF0F\u5173\u7CFB -3\uFF0F\u9690\u853D\u5EA6 -2\u3002\n\u4E25\u91CD\u5931\u8D25\uFF1A\u540D\u671B -3\uFF0F\u5173\u7CFB -5\uFF0F\u9690\u853D\u5EA6 -5\u3002\n\u7B80\u62A5\u9010\u540D\u62AB\u9732\u6B7B\u4EA1\u98CE\u9669\uFF1A\u9009\u62E9\u4E24\u540D\u51FA\u53D1\u6210\u5458\u540E\u9010\u540D\u5217\u51FA\u3002\n\u4E25\u91CD\u5931\u8D25\u65F6\u6BCF\u540D\u961F\u5458\u72EC\u7ACB\u8FDB\u884C 10% \u6B7B\u4EA1\u68C0\u5B9A\uFF0C\u5E78\u5B58\u8005\u8D1F\u4F24\u3002\n\u672A\u4FA6\u5BDF\uFF1A\u53EA\u663E\u793A\u5F53\u524D\u5DF2\u77E5\u5B88\u536B\u4F4D\u7F6E\u3002\n\u6F5C\u5165\u671F\u95F4\u65E0\u6CD5\u5B58\u8BFB\u6863\u3002"
